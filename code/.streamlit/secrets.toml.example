[tumor_auth]
salt = "your-random-salt-here"
hash = "your-hmac-sha256-hex-here"
# Optional extra passwords, same salt, HMAC-SHA256 hex:
# hashes = ["another-digest", "and-another"]

[other_auth]
salt = "a-different-random-salt-here"
hash = "your-hmac-sha256-hex-here"
# Optional extra passwords, same salt, HMAC-SHA256 hex:
# hashes = ["another-digest", "and-another"]

# Generate one credential with:
#   python scripts/hash_tumor_password.py --password YOUR_PASSWORD
#   python scripts/hash_tumor_password.py --section other_auth --password YOUR_PASSWORD
# Reuse an existing salt when adding extra passwords:
#   python scripts/hash_tumor_password.py --section other_auth --salt EXISTING_SALT --password YOUR_PASSWORD
